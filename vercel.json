{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/admin/(.*)", "destination": "/api/admin.js?slug=$1" },
    { "source": "/api/admin", "destination": "/api/admin.js" },
    { "source": "/api/public/(.*)", "destination": "/api/admin.js?public=true&slug=$1" },
    { "source": "/api/public", "destination": "/api/admin.js?public=true" },
    { "source": "/((?!api/|uploads/).*)", "destination": "/index.html" }
  ]
}
